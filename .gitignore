# Next.js 核心缓存/打包文件 (必加)
.next/
out/
build
coverage

# 依赖包 (重中之重，绝对不提交，几百MB)
node_modules/

# 环境变量 (隐私文件，必忽略)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Mac系统隐藏垃圾文件
.DS_Store

# npm/yarn 缓存/日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak
yarn.lock.bak

# 编辑器/IDE配置
.vscode/
.idea/
*.swp
*.swo